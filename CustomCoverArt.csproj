<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Indirection so the jellyfin-compat workflow can retarget the build when a
      future Jellyfin major moves the target framework again (12.x ships for
      net10.0). Overriding TargetFramework directly is unreliable:
      MSBuild special-cases it during ProjectReference negotiation, so the test
      project would not pass it through to this one. A custom property does.
    -->
    <PluginTargetFramework Condition="'$(PluginTargetFramework)' == ''">net10.0</PluginTargetFramework>
    <TargetFramework>$(PluginTargetFramework)</TargetFramework>
    <RootNamespace>CustomCoverArt</RootNamespace>
    <AssemblyName>CustomCoverArt</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
    <!-- GPL-3.0-only: the plugin links against Jellyfin.Controller/Jellyfin.Model,
         which are themselves GPL-3.0-only. See LICENSE. -->
    <Copyright>Copyright © 2026 Bardesss. Licensed under GPL-3.0-only.</Copyright>
    <!-- Single source of truth for the plugin version. Bump this in a PR;
         merging to main triggers a release of the new version. -->
    <Version>4.1.3.0</Version>
    <!--
      Single source of truth for the Jellyfin package versions. Overridable so the
      jellyfin-compat workflow can build against a newer server release without
      editing this file: dotnet build -p:JellyfinVersion=12.0.1
      Keep this in sync with the same property in tests/CustomCoverArt.Tests.
    -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0.0</JellyfinVersion>
    <!--
      SkiaSharp is provided by the Jellyfin server, which loads it (and the native
      libSkiaSharp/libHarfBuzzSharp) at startup. Compile against exactly the version
      Jellyfin 12 ships (Directory.Packages.props, v12.0 to v12.4) and never ship a copy:
      PluginManager loads every DLL in the plugin folder, and a second SkiaSharp with a
      different native range throws on first use. The jellyfin-compat workflow checks this
      pin against the latest Jellyfin release. Keep in sync with the test project.
    -->
    <SkiaSharpVersion Condition="'$(SkiaSharpVersion)' == ''">3.119.4</SkiaSharpVersion>
    <HarfBuzzSharpVersion Condition="'$(HarfBuzzSharpVersion)' == ''">8.3.1.5</HarfBuzzSharpVersion>
  </PropertyGroup>

  <!--
    Jellyfin plugin references. ExcludeAssets=runtime is REQUIRED: these
    assemblies are provided by the Jellyfin server at runtime, and shipping
    our own copies would break plugin loading.
    Versions must match the target server's major version (12.x here).
  -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" ExcludeAssets="runtime;native" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="$(SkiaSharpVersion)" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <!-- The test project lives under tests/ with its own csproj; keep its sources
       out of this project's default compilation. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="docs/**/*.cs" />
    <Compile Remove=".superpowers/**/*.cs" />
  </ItemGroup>

  <!-- Lets the test project pin internal render/limit helpers without widening the public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CustomCoverArt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.css" />
    <EmbeddedResource Include="Configuration\configPage.js" />
    <EmbeddedResource Include="Resources\**\*.json" />
    <!-- Bundled default fonts (Noto Sans, SIL OFL-1.1) so text always renders,
         even on Jellyfin Docker images that have no system fonts installed. -->
    <EmbeddedResource Include="Resources\fonts\*.ttf" />
  </ItemGroup>

</Project>
